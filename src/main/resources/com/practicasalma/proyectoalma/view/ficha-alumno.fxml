<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.practicasalma.proyectoalma.controller.FichaAlumnoController"
            stylesheets="@../css/estilos.css"
            prefWidth="850" prefHeight="650"
            style="-fx-background-color: white;">

    <top>
        <VBox spacing="5" style="-fx-padding: 20 20 10 20;">
            <Label text="Ficha del Alumno" styleClass="title-2" style="-fx-text-fill: #2E5374; -fx-font-weight: bold;"/>
            <Separator/>
        </VBox>
    </top>

    <center>
        <HBox spacing="20" style="-fx-padding: 10 20 20 20;">

            <VBox spacing="20" style="-fx-background-color: #f0f4f8; -fx-padding: 20; -fx-background-radius: 8;" prefWidth="250" alignment="TOP_CENTER">
                <StackPane style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-color: white;" prefHeight="160" prefWidth="140">
                    <ImageView fx:id="imgFoto" fitWidth="130" fitHeight="150" preserveRatio="true"/>
                </StackPane>
                <Button text="Cambiar Foto..." onAction="#seleccionarFoto" style="-fx-background-color: transparent; -fx-text-fill: #2E5374; -fx-cursor: hand; -fx-underline: true;"/>

                <Separator/>

                <VBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Autorizaciones" style="-fx-font-weight: bold; -fx-text-fill: #2E5374;"/>
                    <CheckBox fx:id="chkAutoDatos" text="Protección Datos"/>
                    <CheckBox fx:id="chkAutoImagen" text="Uso Imagen"/>
                    <CheckBox fx:id="chkAutoActividades" text="Actividades"/>
                    <CheckBox fx:id="chkAutoComunicaciones" text="Comunicaciones"/>
                    <CheckBox fx:id="chkAutoIrseSolo" text="Autoriza Irse Solo"/>
                </VBox>
            </VBox>

            <VBox spacing="20" HBox.hgrow="ALWAYS">
                <GridPane hgap="15" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints minWidth="90" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
                        <ColumnConstraints minWidth="90" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
                    </columnConstraints>

                    <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Apellidos:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtApellidos" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <Label text="DNI / NIE:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtDni" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Fecha Nac.:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                    <DatePicker fx:id="dpFechaNacimiento" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Dirección:" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtDireccion" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                    <Label text="Colegio:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtColegio" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Derivado por:" GridPane.columnIndex="2" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtDerivado" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                </GridPane>

                <Separator/>

                <VBox spacing="10">
                    <Accordion>
                        <panes>
                            <TitledPane text="Padres / Tutores Legales" animated="true">
                                <VBox spacing="10"><Label text="Lista de tutores irá aquí..." style="-fx-text-fill: gray;"/></VBox>
                            </TitledPane>
                            <TitledPane text="Personas Autorizadas (Recogida)" animated="true">
                                <VBox spacing="10"><Label text="Lista de autorizados irá aquí..." style="-fx-text-fill: gray;"/></VBox>
                            </TitledPane>
                            <TitledPane text="Historial de Matrículas" animated="true">
                                <VBox spacing="10"><Label text="Lista de cursos irá aquí..." style="-fx-text-fill: gray;"/></VBox>
                            </TitledPane>
                        </panes>
                    </Accordion>
                </VBox>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 10 20 20 20;">
            <Button text="Cancelar" onAction="#cerrarVentana" style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-border-color: #999999; -fx-border-radius: 6; -fx-cursor: hand; -fx-padding: 8 15;"/>
            <Button fx:id="btnGuardar" text="Guardar Cambios" onAction="#guardarDatos" styleClass="boton-accion"/>
        </HBox>
    </bottom>

</BorderPane>
