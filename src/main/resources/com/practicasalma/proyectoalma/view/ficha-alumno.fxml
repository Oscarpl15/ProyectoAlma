<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.practicasalma.proyectoalma.controller.FichaAlumnoController"
            stylesheets="@../css/estilos.css"
            styleClass="fondo-blanco">

    <top>
        <VBox spacing="5" styleClass="padding-cabecera-ficha">
            <Label text="Ficha del Alumno" styleClass="titulo-ventana"/>
            <Separator/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="fondo-blanco">
        <HBox spacing="20" styleClass="padding-cuerpo-ficha">

            <VBox spacing="20" styleClass="panel-lateral-ficha" alignment="TOP_CENTER">
                <StackPane styleClass="caja-foto">
                    <ImageView fx:id="imgFoto" fitWidth="130" fitHeight="150" preserveRatio="true"/>
                </StackPane>
                <Button fx:id="btnCambiarFoto" text="Cambiar Foto..." onAction="#seleccionarFoto" styleClass="boton-enlace"/>

                <Separator/>

                <VBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Autorizaciones" styleClass="titulo-seccion"/>
                    <CheckBox fx:id="chkAutoDatos" text="Protección Datos"/>
                    <CheckBox fx:id="chkAutoImagen" text="Uso Imagen"/>
                    <CheckBox fx:id="chkAutoActividades" text="Actividades"/>
                    <CheckBox fx:id="chkAutoComunicaciones" text="Comunicaciones"/>
                    <CheckBox fx:id="chkAutoIrseSolo" text="Autoriza Irse Solo"/>
                </VBox>

                <Separator/>

                <VBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Estado" styleClass="titulo-seccion"/>
                    <Label fx:id="lblEstado" styleClass="texto-lectura-simple"/>
                </VBox>
            </VBox>

            <VBox spacing="20" HBox.hgrow="ALWAYS">
                <GridPane hgap="15" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints minWidth="90" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
                        <ColumnConstraints minWidth="90" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
                    </columnConstraints>

                    <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="campo-lectura"/>

                    <Label text="Apellidos:" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtApellidos" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="campo-lectura"/>

                    <StackPane GridPane.columnIndex="0" GridPane.rowIndex="1" alignment="CENTER_RIGHT">
                        <Label fx:id="lblTipoDocLectura" text="DNI:" styleClass="etiqueta-campo"/>
                        <ComboBox fx:id="comboTipoDocumento" styleClass="combo-tipo-doc" visible="false" managed="false"/>
                    </StackPane>
                    <TextField fx:id="txtDni" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="campo-lectura"/>

                    <Label text="Fecha Nac.:" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="etiqueta-campo"/>
                    <DatePicker fx:id="dpFechaNacimiento" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="campo-lectura" maxWidth="Infinity"/>

                    <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="campo-lectura"/>

                    <Label text="Dirección:" GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtDireccion" GridPane.columnIndex="3" GridPane.rowIndex="2" styleClass="campo-lectura"/>

                    <Label text="Ciudad:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtCiudad" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="campo-lectura"/>

                    <Label text="Cód. Postal:" GridPane.columnIndex="2" GridPane.rowIndex="3" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtCodigoPostal" GridPane.columnIndex="3" GridPane.rowIndex="3" styleClass="campo-lectura"/>

                    <Label text="Nacionalidad:" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtNacionalidad" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="campo-lectura"/>

                    <Label text="Género:" GridPane.columnIndex="2" GridPane.rowIndex="4" styleClass="etiqueta-campo"/>
                    <StackPane GridPane.columnIndex="3" GridPane.rowIndex="4" alignment="CENTER_LEFT">
                        <TextField fx:id="txtGeneroLectura" styleClass="campo-lectura" editable="false"/>
                        <ComboBox fx:id="comboGenero" maxWidth="Infinity" visible="false" managed="false"/>
                    </StackPane>

                    <Label text="Colegio:" GridPane.columnIndex="0" GridPane.rowIndex="5" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtColegio" GridPane.columnIndex="1" GridPane.rowIndex="5" styleClass="campo-lectura"/>

                    <Label text="Curso Actual:" GridPane.columnIndex="2" GridPane.rowIndex="5" styleClass="etiqueta-campo"/>
                    <StackPane GridPane.columnIndex="3" GridPane.rowIndex="5" alignment="CENTER_LEFT">
                        <TextField fx:id="txtCurso" styleClass="campo-lectura" editable="false"/>
                        <ComboBox fx:id="comboCurso" maxWidth="Infinity" visible="false" managed="false"/>
                    </StackPane>

                    <Label text="Grupo Asignado:" GridPane.columnIndex="0" GridPane.rowIndex="6" styleClass="etiqueta-campo"/>
                    <StackPane GridPane.columnIndex="1" GridPane.rowIndex="6" alignment="CENTER_LEFT">
                        <TextField fx:id="txtGrupoLectura" styleClass="campo-lectura" editable="false"/>
                        <ComboBox fx:id="comboGrupo" maxWidth="Infinity" visible="false" managed="false"/>
                    </StackPane>
                </GridPane>



                <StackPane alignment="CENTER_LEFT" styleClass="bloque-seguimiento">

                    <VBox fx:id="boxSeguimientoLectura" spacing="5">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Seguimiento:" styleClass="etiqueta-campo"/>
                            <Label fx:id="lblSeguimientoValor" styleClass="texto-lectura-simple"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Derivación:" styleClass="etiqueta-campo"/>
                            <Label fx:id="lblDerivacionValor" styleClass="texto-lectura-simple"/>
                        </HBox>
                    </VBox>

                    <VBox fx:id="boxSeguimientoEdicion" spacing="10" visible="false" managed="false">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="Seguimiento:" styleClass="etiqueta-campo" minWidth="90" alignment="CENTER_RIGHT"/>
                            <CheckBox fx:id="chkSeguimientoSS" text="Servicios Sociales"/>
                            <CheckBox fx:id="chkSeguimientoSAF" text="SAF"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Derivación:" styleClass="etiqueta-campo" minWidth="90" alignment="CENTER_RIGHT"/>
                            <CheckBox fx:id="chkDerivacionSS" text="SS"/>
                            <CheckBox fx:id="chkDerivacionSAF" text="SAF"/>
                            <CheckBox fx:id="chkDerivacionEOEP" text="EOEP"/>
                            <CheckBox fx:id="chkDerivacionColegio" text="Colegio"/>
                            <CheckBox fx:id="chkDerivacionOtro" text="Otro"/>
                            <TextField fx:id="txtDerivado" promptText="¿Quién ha derivado?" HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>
                </StackPane>


                <VBox spacing="10">
                    <Accordion>
                        <panes>
                            <TitledPane text="Padres / Tutores Legales" animated="true">
                                <VBox spacing="10">
                                    <TableView fx:id="tablaTutores" prefHeight="160" maxHeight="160" styleClass="striped, bordered">
                                        <columns>
                                            <TableColumn fx:id="colTutorNombre" text="Nombre" prefWidth="120" reorderable="false"/>
                                            <TableColumn fx:id="colTutorApellidos" text="Apellidos" prefWidth="150" reorderable="false"/>
                                            <TableColumn fx:id="colTutorDni" text="Documento" prefWidth="90" reorderable="false"/>
                                            <TableColumn fx:id="colTutorTelefono" text="Teléfono" prefWidth="100" reorderable="false"/>
                                            <TableColumn fx:id="colTutorRelacion" text="Relación" prefWidth="90" reorderable="false"/>
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                        </columnResizePolicy>
                                    </TableView>
                                    <HBox fx:id="boxBotonesTutores" spacing="10" alignment="CENTER_RIGHT" visible="false" managed="false">
                                        <Button text="Eliminar Seleccionado" onAction="#eliminarTutor" styleClass="boton-cancelar"/>
                                        <Button text="+ Buscar existente" onAction="#agregarTutorExistente" styleClass="boton-secundario"/>
                                        <Button text="+ Nueva persona" onAction="#agregarNuevoTutor" styleClass="boton-secundario"/>
                                    </HBox>
                                </VBox>
                            </TitledPane>
                            <TitledPane text="Personas Autorizadas (Recogida)" animated="true">
                                <VBox spacing="10">
                                    <TableView fx:id="tablaAutorizados" prefHeight="160" maxHeight="160" styleClass="striped, bordered">
                                        <columns>
                                            <TableColumn fx:id="colAutoNombre" text="Nombre" prefWidth="120" reorderable="false"/>
                                            <TableColumn fx:id="colAutoApellidos" text="Apellidos" prefWidth="150" reorderable="false"/>
                                            <TableColumn fx:id="colAutoDni" text="Documento" prefWidth="90" reorderable="false"/>
                                            <TableColumn fx:id="colAutoTelefono" text="Teléfono" prefWidth="100" reorderable="false"/>
                                            <TableColumn fx:id="colAutoRelacion" text="Relación" prefWidth="90" reorderable="false"/>
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                        </columnResizePolicy>
                                    </TableView>

                                    <HBox fx:id="boxBotonesAutorizados" spacing="10" alignment="CENTER_RIGHT" visible="false" managed="false">
                                        <Button text="Eliminar Seleccionado" onAction="#eliminarAutorizado" styleClass="boton-cancelar"/>
                                        <Button text="+ Buscar existente" onAction="#agregarAutorizadoExistente" styleClass="boton-secundario"/>
                                        <Button text="+ Nueva persona" onAction="#agregarAutorizado" styleClass="boton-secundario"/>
                                    </HBox>
                                </VBox>
                            </TitledPane>
                            <TitledPane text="Historial de Matrículas" animated="true">
                                <TableView fx:id="tablaMatriculas" prefHeight="160" maxHeight="160" styleClass="striped, bordered">
                                    <columns>
                                        <TableColumn fx:id="colMatAnyo" text="Año Académico" prefWidth="120" reorderable="false"/>
                                        <TableColumn fx:id="colMatCurso" text="Curso" prefWidth="120" reorderable="false"/>
                                        <TableColumn fx:id="colMatGrupo" text="Grupo" prefWidth="120" reorderable="false"/>
                                        <TableColumn fx:id="colMatRepeticion" text="Repetición" prefWidth="80" reorderable="false"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>
                            </TitledPane>
                        </panes>
                    </Accordion>
                </VBox>
            </VBox>
        </HBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="15" styleClass="padding-pie-ficha">
            <Button fx:id="btnBajaAlta" text="Dar de baja" onAction="#toggleBajaAlta" styleClass="boton-baja"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Añadir documento" onAction="#anadirDocumento" styleClass="boton-accion"/>
            <Button text="Ver documentos" onAction="#verDocumentos" styleClass="boton-accion"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnCerrar" text="Cerrar" onAction="#cerrarVentana" styleClass="boton-cancelar"/>
            <Button fx:id="btnEditar" text="Editar Ficha" onAction="#activarEdicion" styleClass="boton-accion"/>
            <Button fx:id="btnCancelarEdicion" text="Cancelar" onAction="#cancelarEdicion" styleClass="boton-cancelar"/>
            <Button fx:id="btnGuardar" text="Guardar Cambios" onAction="#guardarDatos" styleClass="boton-guardar-exito"/>
        </HBox>
    </bottom>

</BorderPane>
