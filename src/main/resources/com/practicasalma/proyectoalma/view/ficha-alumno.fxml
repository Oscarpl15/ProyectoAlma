<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.practicasalma.proyectoalma.controller.FichaAlumnoController"
            stylesheets="@../css/estilos.css"
            prefWidth="850" prefHeight="650"
            styleClass="fondo-blanco">

    <top>
        <VBox spacing="5" styleClass="padding-cabecera-ficha">
            <Label text="Ficha del Alumno" styleClass="titulo-ventana"/>
            <Separator/>
        </VBox>
    </top>

    <center>
        <HBox spacing="20" styleClass="padding-cuerpo-ficha">

            <VBox spacing="20" styleClass="panel-lateral-ficha" alignment="TOP_CENTER">
                <StackPane styleClass="caja-foto">
                    <ImageView fx:id="imgFoto" fitWidth="130" fitHeight="150" preserveRatio="true"/>
                </StackPane>
                <Button fx:id="btnCambiarFoto" text="Cambiar Foto..." onAction="#seleccionarFoto" styleClass="boton-enlace"/>

                <Separator/>

                <VBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Autorizaciones" styleClass="titulo-seccion"/>
                    <CheckBox fx:id="chkAutoDatos" text="Protección Datos"/>
                    <CheckBox fx:id="chkAutoImagen" text="Uso Imagen"/>
                    <CheckBox fx:id="chkAutoActividades" text="Actividades"/>
                    <CheckBox fx:id="chkAutoComunicaciones" text="Comunicaciones"/>
                    <CheckBox fx:id="chkAutoIrseSolo" text="Autoriza Irse Solo"/>
                </VBox>
            </VBox>

            <VBox spacing="20" HBox.hgrow="ALWAYS">
                <GridPane hgap="15" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints minWidth="90" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
                        <ColumnConstraints minWidth="90" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
                    </columnConstraints>

                    <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="campo-lectura"/>

                    <Label text="Apellidos:" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtApellidos" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="campo-lectura"/>

                    <Label text="DNI / NIE:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtDni" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="campo-lectura"/>

                    <Label text="Fecha Nac.:" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="etiqueta-campo"/>
                    <DatePicker fx:id="dpFechaNacimiento" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="campo-lectura"/>

                    <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="campo-lectura"/>

                    <Label text="Dirección:" GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtDireccion" GridPane.columnIndex="3" GridPane.rowIndex="2" styleClass="campo-lectura"/>

                    <Label text="Colegio:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtColegio" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="campo-lectura"/>

                    <Label text="Derivado por:" GridPane.columnIndex="2" GridPane.rowIndex="3" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtDerivado" GridPane.columnIndex="3" GridPane.rowIndex="3" styleClass="campo-lectura"/>
                </GridPane>

                <Separator/>

                <VBox spacing="10">
                    <Accordion>
                        <panes>
                            <TitledPane text="Padres / Tutores Legales" animated="true">
                                <VBox spacing="10"><Label text="Lista de tutores irá aquí..." styleClass="texto-placeholder"/></VBox>
                            </TitledPane>
                            <TitledPane text="Personas Autorizadas (Recogida)" animated="true">
                                <VBox spacing="10"><Label text="Lista de autorizados irá aquí..." styleClass="texto-placeholder"/></VBox>
                            </TitledPane>
                            <TitledPane text="Historial de Matrículas" animated="true">
                                <VBox spacing="10"><Label text="Lista de cursos irá aquí..." styleClass="texto-placeholder"/></VBox>
                            </TitledPane>
                        </panes>
                    </Accordion>
                </VBox>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="15" styleClass="padding-pie-ficha">
            <Button fx:id="btnCerrar" text="Cerrar" onAction="#cerrarVentana" styleClass="boton-cancelar"/>
            <Button fx:id="btnEditar" text="Editar Ficha" onAction="#activarEdicion" styleClass="boton-accion"/>

            <Button fx:id="btnCancelarEdicion" text="Cancelar" onAction="#cancelarEdicion" styleClass="boton-cancelar"/>
            <Button fx:id="btnGuardar" text="Guardar Cambios" onAction="#guardarDatos" styleClass="boton-guardar-exito"/>
        </HBox>
    </bottom>

</BorderPane>