<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.practicasalma.proyectoalma.controller.AlumnosController"
      spacing="15">

    <HBox alignment="CENTER_RIGHT">
        <TextField promptText="Buscar alumno..." prefWidth="250"/>
    </HBox>

    <TableView fx:id="tablaAlumnos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
            <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="200"/>
            <TableColumn fx:id="colDni" text="DNI" prefWidth="100"/>
            <TableColumn fx:id="colCurso" text="Curso" prefWidth="100"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="+ AÑADIR ALUMNO" onAction="#nuevoAlumno" styleClass="boton-accion"/>
    </HBox>

</VBox>