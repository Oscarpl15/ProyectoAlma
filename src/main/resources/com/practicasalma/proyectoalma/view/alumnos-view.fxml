<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.practicasalma.proyectoalma.controller.AlumnosController"
      spacing="15" styleClass="contenedor-padding-estandar">

    <BorderPane>
        <left>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <ComboBox fx:id="comboCursoFiltro" prefWidth="150" promptText="Curso">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="2024-2025"/>
                            <String fx:value="2025-2026"/>
                            <String fx:value="2026-2027"/>
                        </FXCollections>
                    </items>
                </ComboBox>

                <ComboBox fx:id="comboGrupoFiltro" prefWidth="150" promptText="Grupo Asignado">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="G1 Lunes"/>
                            <String fx:value="G1 Martes"/>
                            <String fx:value="G2 Lunes"/>
                            <String fx:value="G2 Martes"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </HBox>
        </left>
        <right>
            <HBox alignment="CENTER_RIGHT">
                <TextField fx:id="txtBuscar" promptText="Buscar alumno..." prefWidth="250"/>
            </HBox>
        </right>
    </BorderPane>

    <TableView fx:id="tablaAlumnos" VBox.vgrow="ALWAYS" styleClass="striped, bordered">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150" reorderable="false"/>
            <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="200" reorderable="false"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="110" reorderable="false"/>
            <TableColumn fx:id="colGrupo" text="Grupo" prefWidth="90" reorderable="false"/>

            <TableColumn text="Autorizaciones" reorderable="false">
                <columns>
                    <TableColumn fx:id="colAutoDatos" text="Datos" prefWidth="60" reorderable="false"/>
                    <TableColumn fx:id="colAutoActividades" text="Activ." prefWidth="60" reorderable="false"/>
                    <TableColumn fx:id="colAutoComunicaciones" text="Com." prefWidth="60" reorderable="false"/>
                    <TableColumn fx:id="colAutoImagen" text="Imagen" prefWidth="65" reorderable="false"/>
                    <TableColumn fx:id="colAutoIrseSolo" text="Irse Solo" prefWidth="75" reorderable="false"/>
                </columns>
            </TableColumn>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="75" reorderable="false"/>
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="+ AÑADIR ALUMNO" onAction="#nuevoAlumno" styleClass="boton-accion"/>
    </HBox>

</VBox>