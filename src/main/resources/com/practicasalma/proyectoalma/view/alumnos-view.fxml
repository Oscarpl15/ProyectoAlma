<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.practicasalma.proyectoalma.controller.AlumnosController"
      spacing="15" styleClass="contenedor-padding-estandar">

    <BorderPane>
        <left>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <ComboBox fx:id="comboCursoFiltro" prefWidth="130"/>
                <ComboBox fx:id="comboCursoAlumnoFiltro" prefWidth="140"/>
                <ComboBox fx:id="comboGrupoFiltro" prefWidth="175"/><ComboBox fx:id="comboEstadoFiltro" prefWidth="110"/>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <HBox.margin><Insets left="20"/></HBox.margin>
                    <Label text="Seguimiento:" styleClass="etiqueta-campo"/>
                    <CheckBox fx:id="chkSeguimientoSS" text="Servicios Sociales"/>
                    <CheckBox fx:id="chkSeguimientoSAF" text="SAF"/>
                </HBox>
            </HBox>
        </left>
        <right>
            <HBox alignment="CENTER_RIGHT">
                <TextField fx:id="txtBuscar" promptText="Buscar alumno..." prefWidth="250"/>
            </HBox>
        </right>
    </BorderPane>

    <TableView fx:id="tablaAlumnos" VBox.vgrow="ALWAYS" styleClass="striped, bordered">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="120" reorderable="false"/>
            <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="190" reorderable="false"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="150" reorderable="false"/>
            <TableColumn fx:id="colGrupo" text="Grupo" prefWidth="90" reorderable="false"/>

            <TableColumn text="Autorizaciones" reorderable="false">
                <columns>
                    <TableColumn fx:id="colAutoDatos" text="Datos" prefWidth="60" reorderable="false"/>
                    <TableColumn fx:id="colAutoActividades" text="Activ." prefWidth="60" reorderable="false"/>
                    <TableColumn fx:id="colAutoComunicaciones" text="Com." prefWidth="60" reorderable="false"/>
                    <TableColumn fx:id="colAutoImagen" text="Imagen" prefWidth="65" reorderable="false"/>
                    <TableColumn fx:id="colAutoIrseSolo" text="Irse Solo" prefWidth="75" reorderable="false"/>
                </columns>
            </TableColumn>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="75" reorderable="false"/>
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="PDF GRUPOS" onAction="#exportarPdfGrupos" styleClass="boton-accion"/>
        <Button text="+ AÑADIR ALUMNO" onAction="#nuevoAlumno" styleClass="boton-accion"/>
    </HBox>

</VBox>
