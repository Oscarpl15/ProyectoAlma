<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.practicasalma.proyectoalma.controller.SocioController"
      spacing="15" styleClass="contenedor-padding-estandar">

    <BorderPane>
        <left>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <ComboBox fx:id="comboTipoEntidadFiltro" prefWidth="150" promptText="Tipo Entidad">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Física"/>
                            <String fx:value="Empresa"/>
                            <String fx:value="Asociación"/>
                        </FXCollections>
                    </items>
                </ComboBox>
                <ComboBox fx:id="comboPeriodicidadFiltro" prefWidth="150" promptText="Periodicidad">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Mensual"/>
                            <String fx:value="Trimestral"/>
                            <String fx:value="Anual"/>
                            <String fx:value="Puntual"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </HBox>
        </left>
        <right>
            <HBox alignment="CENTER_RIGHT">
                <TextField fx:id="txtBuscar" promptText="Buscar Socio..." prefWidth="250"/>
            </HBox>
        </right>
    </BorderPane>

    <TableView fx:id="tablaSocios" VBox.vgrow="ALWAYS" styleClass="striped, bordered">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180" reorderable="false"/>
            <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="200" reorderable="false"/>
            <TableColumn fx:id="colDni" text="DNI / CIF" prefWidth="100" reorderable="false"/>
            <TableColumn fx:id="colTipoEntidad" text="Tipo Entidad" prefWidth="120" reorderable="false"/>
            <TableColumn fx:id="colPeriodicidad" text="Periodicidad" prefWidth="120" reorderable="false"/>
            <TableColumn fx:id="colCuota" text="Cuota (€)" prefWidth="90" reorderable="false"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="+ AÑADIR SOCIO" onAction="#nuevoSocio" styleClass="boton-accion"/>
    </HBox>

</VBox>
