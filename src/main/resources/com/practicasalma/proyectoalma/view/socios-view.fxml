<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.practicasalma.proyectoalma.controller.SocioController"
      spacing="15" styleClass="contenedor-padding-estandar">

    <BorderPane>
        <left>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <ComboBox fx:id="comboTipoEntidadFiltro" prefWidth="150"/>
                <ComboBox fx:id="comboPeriodicidadFiltro" prefWidth="130"/>
                <ComboBox fx:id="comboEstadoFiltro" prefWidth="110"/>
            </HBox>
        </left>
        <right>
            <HBox alignment="CENTER_RIGHT">
                <TextField fx:id="txtBuscar" promptText="Buscar Socio..." prefWidth="250"/>
            </HBox>
        </right>
    </BorderPane>

    <TableView fx:id="tablaSocios" VBox.vgrow="ALWAYS" styleClass="striped, bordered">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180" reorderable="false"/>
            <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="200" reorderable="false"/>
            <TableColumn fx:id="colDni" text="DNI / CIF" prefWidth="100" reorderable="false"/>
            <TableColumn fx:id="colTipoEntidad" text="Tipo Entidad" prefWidth="120" reorderable="false"/>
            <TableColumn fx:id="colPeriodicidad" text="Periodicidad" prefWidth="120" reorderable="false"/>
            <TableColumn fx:id="colCuota" text="Cuota (€)" prefWidth="90" reorderable="false"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="80" reorderable="false"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="+ AÑADIR SOCIO" onAction="#nuevoSocio" styleClass="boton-accion"/>
    </HBox>

</VBox>
