<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="768" prefWidth="1024" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.practicasalma.proyectoalma.controller.MainController">

    <ImageView fitHeight="768.0" fitWidth="1024.0" opacity="0.25" preserveRatio="false">
        <image>
            <Image url="@../assets/logo.png" />
        </image>
    </ImageView>

    <BorderPane>
        <top>
            <StackPane alignment="CENTER" styleClass="header-panel">
                <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                    <ImageView fitHeight="200.0" fitWidth="200.0" preserveRatio="true">
                        <image>
                            <Image url="@../assets/logo.png" />
                        </image>
                    </ImageView>
                </HBox>
                <VBox alignment="CENTER" spacing="60">
                    <HBox alignment="CENTER">
                        <Label styleClass="title-1, titulo-app" text="Fundación Gestión" />
                    </HBox>
                    <HBox alignment="BOTTOM_CENTER" spacing="10">
                        <Button onAction="#mostrarAlumnos" styleClass="boton-menu" text="ALUMNOS">
                            <HBox.margin>
                                <Insets right="20.0" />
                            </HBox.margin>
                        </Button>
                        <Button onAction="#mostrarDocentes" styleClass="boton-menu" text="DOCENTES" >
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </Button>
                        <Button onAction="#mostrarVoluntarios" styleClass="boton-menu" text="VOLUNTARIOS" >
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </Button>
                        <Button onAction="#mostrarSocios" styleClass="boton-menu" text="SOCIOS">
                            <HBox.margin>
                                <Insets left="20.0" />
                            </HBox.margin>
                        </Button>
                    </HBox>
                </VBox>
            </StackPane>
        </top>

        <center>
            <BorderPane style="-fx-padding: 20;">
                <center>
                    <TabPane fx:id="tabPrincipal" tabClosingPolicy="UNAVAILABLE" tabMaxHeight="0" tabMinHeight="0">
                        <tabs>
                            <Tab><content><fx:include source="alumnos-view.fxml" /></content></Tab>
                            <Tab><content><fx:include source="docentes-view.fxml" /></content></Tab>
                            <Tab><content><fx:include source="voluntarios-view.fxml" /></content></Tab>
                            <Tab><content><fx:include source="socios-view.fxml"/></content></Tab>
                        </tabs>
                    </TabPane>
                </center>
            </BorderPane>
        </center>
    </BorderPane>
</StackPane>