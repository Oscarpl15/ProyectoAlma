    <top>
        <StackPane alignment="CENTER" styleClass="header-panel">
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                <ImageView fitHeight="200.0" fitWidth="200.0" preserveRatio="true">
                    <image>
                        <Image url="@../assets/logo.png" />
                    </image>
                </ImageView>
            </HBox>
            <VBox alignment="CENTER" spacing="60">
                <HBox alignment="CENTER">
                    <Label styleClass="titulo-app" text="Fundación Gestión" />

                </HBox>
                <HBox alignment="BOTTOM_CENTER" spacing="10">
                    <Button onAction="#mostrarAlumnos" styleClass="boton-accion" text="ALUMNOS">
                  <HBox.margin>
                     <Insets right="20.0" />
                  </HBox.margin></Button>
                    <Button onAction="#mostrarDocentes" styleClass="boton-accion" text="DOCENTES" />
                    <Button onAction="#mostrarSocios" styleClass="boton-accion" text="SOCIOS">
                  <HBox.margin>
                     <Insets left="20.0" />
                  </HBox.margin></Button>
                </HBox>
            </VBox>

        </StackPane>
    </top>

    <center>
        <BorderPane style="-fx-padding: 20;">
            <center>
                <TabPane fx:id="tabPrincipal" tabClosingPolicy="UNAVAILABLE" tabMaxHeight="0" tabMinHeight="0">
                    <tabs>
                        <Tab>
                            <content>
                                <fx:include source="alumnos-view.fxml" />
                            </content>
                        </Tab>

                        <Tab>
                            <content>
                                <fx:include source="docentes-view.fxml" />
                            </content>
                        </Tab>

                        <Tab>
                            <content>
                                <fx:include source="socios-view.fxml"/>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
