<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane fx:id="rootPane" prefHeight="768" prefWidth="1024" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.practicasalma.proyectoalma.controller.MainController">

    <ImageView fx:id="imgFondo" opacity="1" preserveRatio="false">
        <image>
            <Image url="@../assets/Fondo1.png" />
        </image>
    </ImageView>

    <BorderPane fx:id="mainLayout">
        <top>
            <StackPane styleClass="header-panel">
                <ImageView fitHeight="200.0" fitWidth="200.0" preserveRatio="true" styleClass="logo-fundacion" StackPane.alignment="CENTER_LEFT">
                    <image>
                        <Image url="@../assets/logo.png" />
                    </image>
                </ImageView>

                <HBox alignment="TOP_RIGHT" StackPane.alignment="TOP_RIGHT">
                    <padding><Insets top="20" right="15"/></padding>
                    <Button fx:id="btnAjustes" onAction="#abrirMenuAjustes" styleClass="boton-ajustes">
                        <graphic>
                            <ImageView fitWidth="52" fitHeight="52" preserveRatio="true">
                                <image><Image url="@../assets/Ajustes.png"/></image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>

                <VBox alignment="CENTER" spacing="60" pickOnBounds="false">
                    <HBox alignment="CENTER" mouseTransparent="true">
                        <Label styleClass="title-1, titulo-app" text="Fundación Gestión" />
                    </HBox>

                    <fx:define>
                        <ToggleGroup fx:id="menuGroup"/>
                        <ContextMenu fx:id="menuAjustes">
                            <items>
                                <MenuItem text="Cambiar directorio BD" onAction="#cambiarDirectorioBBDD"/>
                                <MenuItem text="Cambiar directorio documentos" onAction="#cambiarDirectorioDocs"/>
                                <SeparatorMenuItem/>
                                <MenuItem text="Gestor de credenciales de correo" onAction="#configurarCorreo"/>
                                <SeparatorMenuItem/>
                                <MenuItem text="Gestionar grupos" onAction="#gestionarGrupos"/>
                                <SeparatorMenuItem/>
                                <MenuItem text="Fechas automáticas" onAction="#abrirAjustesFechas"/>
                                <SeparatorMenuItem/>
                                <MenuItem text="Regularidad de copia de seguridad" onAction="#abrirAjustesBackup"/>
                            </items>
                        </ContextMenu>
                    </fx:define>

                    <HBox alignment="BOTTOM_CENTER" spacing="10">
                        <ToggleButton onAction="#mostrarAlumnos" styleClass="boton-menu" text="ALUMNOS" toggleGroup="$menuGroup" selected="true">
                            <HBox.margin><Insets right="20.0" /></HBox.margin>
                        </ToggleButton>
                        <ToggleButton onAction="#mostrarDocentes" styleClass="boton-menu" text="DOCENTES" toggleGroup="$menuGroup">
                            <HBox.margin><Insets right="10.0" /></HBox.margin>
                        </ToggleButton>
                        <ToggleButton onAction="#mostrarVoluntarios" styleClass="boton-menu" text="VOLUNTARIOS" toggleGroup="$menuGroup">
                            <HBox.margin><Insets left="10.0" /></HBox.margin>
                        </ToggleButton>
                        <ToggleButton onAction="#mostrarSocios" styleClass="boton-menu" text="SOCIOS" toggleGroup="$menuGroup">
                            <HBox.margin><Insets left="20.0" /></HBox.margin>
                        </ToggleButton>
                        <ToggleButton onAction="#mostrarGraficas" styleClass="boton-menu" text="GRAFICAS" toggleGroup="$menuGroup">
                            <HBox.margin><Insets left="20.0" /></HBox.margin>
                        </ToggleButton>
                    </HBox>
                </VBox>
            </StackPane>
        </top>

        <center>
            <BorderPane styleClass="contenedor-padding-estandar">
                <center>
                    <TabPane fx:id="tabPrincipal" tabClosingPolicy="UNAVAILABLE" tabMaxHeight="0" tabMinHeight="0">
                        <tabs>
                            <Tab><content><fx:include fx:id="alumnos" source="alumnos-view.fxml" /></content></Tab>
                            <Tab><content><fx:include fx:id="docentes" source="docentes-view.fxml" /></content></Tab>
                            <Tab><content><fx:include fx:id="voluntarios" source="voluntarios-view.fxml" /></content></Tab>
                            <Tab><content><fx:include source="socios-view.fxml"/></content></Tab>
                            <Tab><content><fx:include fx:id="graficas" source="graficas-view.fxml"/></content></Tab>
                        </tabs>
                    </TabPane>
                </center>
            </BorderPane>
        </center>
    </BorderPane>
</StackPane>
