<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.practicasalma.proyectoalma.controller.FichaSocioController"
            stylesheets="@../css/estilos.css"
            styleClass="fondo-blanco">

    <top>
        <VBox spacing="5" styleClass="padding-cabecera-ficha">
            <Label text="Ficha del Socio" styleClass="titulo-ventana"/>
            <Separator/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="fondo-blanco">
        <HBox spacing="20" styleClass="padding-cuerpo-ficha">

            <VBox spacing="20" styleClass="panel-lateral-ficha" alignment="TOP_CENTER">
                <StackPane styleClass="caja-foto">
                    <ImageView fx:id="imgFoto" fitWidth="130" fitHeight="150" preserveRatio="true"/>
                </StackPane>
                <Button fx:id="btnCambiarFoto" text="Cambiar Foto..." onAction="#seleccionarFoto" styleClass="boton-enlace"/>

                <Separator/>

                <VBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Estado" styleClass="titulo-seccion"/>
                    <Label fx:id="lblEstado" styleClass="texto-lectura-simple"/>
                </VBox>
            </VBox>

            <VBox spacing="20" HBox.hgrow="ALWAYS">
                <GridPane hgap="15" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints minWidth="90" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
                        <ColumnConstraints minWidth="90" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
                    </columnConstraints>

                    <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="campo-lectura"/>

                    <Label text="Apellidos:" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtApellidos" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="campo-lectura"/>

                    <StackPane GridPane.columnIndex="0" GridPane.rowIndex="1" alignment="CENTER_RIGHT">
                        <Label fx:id="lblTipoDocLectura" text="DNI:" styleClass="etiqueta-campo"/>
                        <ComboBox fx:id="comboTipoDocumento" styleClass="combo-tipo-doc" visible="false" managed="false"/>
                    </StackPane>
                    <TextField fx:id="txtDni" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="campo-lectura"/>

                    <Label text="Teléfono:" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtTelefono" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="campo-lectura"/>

                    <Label text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtCorreo" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="campo-lectura"/>

                    <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtDireccion" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="campo-lectura"/>

                    <Label text="Cód. Postal:" GridPane.columnIndex="2" GridPane.rowIndex="3" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtCodigoPostal" GridPane.columnIndex="3" GridPane.rowIndex="3" styleClass="campo-lectura"/>

                    <Label text="Ciudad:" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtCiudad" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="campo-lectura"/>

                    <Label text="Provincia:" GridPane.columnIndex="2" GridPane.rowIndex="4" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtProvincia" GridPane.columnIndex="3" GridPane.rowIndex="4" styleClass="campo-lectura"/>

                    <Label text="Nacionalidad:" GridPane.columnIndex="0" GridPane.rowIndex="5" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtNacionalidad" GridPane.columnIndex="1" GridPane.rowIndex="5" styleClass="campo-lectura"/>

                    <Label text="Género:" GridPane.columnIndex="2" GridPane.rowIndex="5" styleClass="etiqueta-campo"/>
                    <StackPane GridPane.columnIndex="3" GridPane.rowIndex="5" alignment="CENTER_LEFT">
                        <TextField fx:id="txtGeneroLectura" styleClass="campo-lectura" editable="false"/>
                        <ComboBox fx:id="comboGenero" maxWidth="Infinity" visible="false" managed="false"/>
                    </StackPane>

                    <Label text="Tipo Entidad:" GridPane.columnIndex="0" GridPane.rowIndex="6" styleClass="etiqueta-campo"/>
                    <StackPane GridPane.columnIndex="1" GridPane.rowIndex="6" alignment="CENTER_LEFT">
                        <TextField fx:id="txtTipoEntidadLectura" styleClass="campo-lectura" editable="false"/>
                        <ComboBox fx:id="comboTipoEntidad" maxWidth="Infinity" visible="false" managed="false"/>
                    </StackPane>

                    <Label text="Forma de Pago:" GridPane.columnIndex="2" GridPane.rowIndex="6" styleClass="etiqueta-campo"/>
                    <StackPane GridPane.columnIndex="3" GridPane.rowIndex="6" alignment="CENTER_LEFT">
                        <TextField fx:id="txtFormaPagoLectura" styleClass="campo-lectura" editable="false"/>
                        <ComboBox fx:id="comboFormaPago" maxWidth="Infinity" visible="false" managed="false"/>
                    </StackPane>

                    <Label text="Periodicidad:" GridPane.columnIndex="0" GridPane.rowIndex="7" styleClass="etiqueta-campo"/>
                    <StackPane GridPane.columnIndex="1" GridPane.rowIndex="7" alignment="CENTER_LEFT">
                        <TextField fx:id="txtPeriodicidadLectura" styleClass="campo-lectura" editable="false"/>
                        <ComboBox fx:id="comboPeriodicidad" maxWidth="Infinity" visible="false" managed="false"/>
                    </StackPane>

                    <Label text="Cuota (€):" GridPane.columnIndex="2" GridPane.rowIndex="7" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtCuota" GridPane.columnIndex="3" GridPane.rowIndex="7" styleClass="campo-lectura"/>

                    <Label fx:id="lblFechaCambioPeriodicidad" text="Fecha inicio:" GridPane.columnIndex="0" GridPane.rowIndex="8" styleClass="etiqueta-campo" visible="false" managed="false"/>
                    <DatePicker fx:id="dpFechaCambioPeriodicidad" GridPane.columnIndex="1" GridPane.rowIndex="8" maxWidth="Infinity" visible="false" managed="false"/>
                </GridPane>

                <VBox spacing="10">
                    <Accordion>
                        <panes>
                            <TitledPane text="Datos Bancarios" animated="true">
                                <GridPane hgap="15" vgap="12">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="110" halignment="RIGHT"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints minWidth="110" halignment="RIGHT"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <Label text="Cuenta:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="etiqueta-campo"/>
                                    <TextField fx:id="txtCuentaBancaria" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="campo-lectura"/>
                                    <Label text="Cód. BIC:" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="etiqueta-campo"/>
                                    <TextField fx:id="txtCodigoBic" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="campo-lectura"/>
                                    <Label text="Banco:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="etiqueta-campo"/>
                                    <TextField fx:id="txtTipoBanco" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="campo-lectura"/>
                                </GridPane>
                            </TitledPane>
                            <TitledPane text="Historial de Donaciones" animated="true">
                                <VBox spacing="8">
                                    <TableView fx:id="tablaDonaciones" prefHeight="160" maxHeight="160" styleClass="striped, bordered">
                                        <columns>
                                            <TableColumn fx:id="colDonFecha" text="Fecha" prefWidth="100" reorderable="false"/>
                                            <TableColumn fx:id="colDonImporte" text="Importe (€)" prefWidth="100" reorderable="false"/>
                                            <TableColumn fx:id="colDonPeriodicidad" text="Periodicidad" prefWidth="100" reorderable="false"/>
                                            <TableColumn fx:id="colDonDescripcion" text="Forma de Pago" prefWidth="150" reorderable="false"/>
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                        </columnResizePolicy>
                                    </TableView>
                                    <HBox alignment="CENTER_RIGHT">
                                        <Button fx:id="btnAnadirDonativo" text="+ Añadir donativo" onAction="#anadirDonativo" styleClass="boton-secundario"/>
                                    </HBox>
                                </VBox>
                            </TitledPane>
                        </panes>
                    </Accordion>
                </VBox>
            </VBox>
        </HBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="15" styleClass="padding-pie-ficha">
            <Button fx:id="btnBajaAlta" text="Dar de baja" onAction="#toggleBajaAlta" styleClass="boton-baja"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Añadir documento" onAction="#anadirDocumento" styleClass="boton-accion"/>
            <Button text="Ver documentos" onAction="#verDocumentos" styleClass="boton-accion"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnCerrar" text="Cerrar" onAction="#cerrarVentana" styleClass="boton-cancelar"/>
            <Button fx:id="btnEnviarInforme" text="Enviar informe" onAction="#enviarInforme" styleClass="boton-accion"/>
            <Button fx:id="btnEditar" text="Editar Ficha" onAction="#activarEdicion" styleClass="boton-accion"/>
            <Button fx:id="btnCancelarEdicion" text="Cancelar" onAction="#cancelarEdicion" styleClass="boton-cancelar"/>
            <Button fx:id="btnGuardar" text="Guardar Cambios" onAction="#guardarDatos" styleClass="boton-guardar-exito"/>
        </HBox>
    </bottom>

</BorderPane>
