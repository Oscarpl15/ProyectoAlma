<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.practicasalma.proyectoalma.controller.AgregarDocenteController"
            prefWidth="700.0"
            styleClass="fondo-blanco"
            stylesheets="@../css/estilos.css">

    <VBox spacing="20.0" AnchorPane.topAnchor="20.0" AnchorPane.bottomAnchor="20.0"
          AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0">

        <VBox spacing="5">
            <Label text="Añadir Nuevo Docente" styleClass="titulo-ventana"/>
            <Label text="Rellena los datos personales y marca los certificados correspondientes." styleClass="subtitulo-ventana"/>
        </VBox>

        <GridPane vgap="15.0" hgap="15.0">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="90.0" halignment="RIGHT"/>
                <ColumnConstraints hgrow="ALWAYS" prefWidth="200.0"/>
                <ColumnConstraints hgrow="NEVER" minWidth="90.0" halignment="RIGHT"/>
                <ColumnConstraints hgrow="ALWAYS" prefWidth="200.0"/>
            </columnConstraints>

            <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="etiqueta-campo"/>
            <TextField fx:id="txtNombre" promptText="Ej: Javier" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Apellidos:" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="etiqueta-campo"/>
            <TextField fx:id="txtApellidos" promptText="Ej: García Pérez" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="DNI/NIE:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="etiqueta-campo"/>
            <TextField fx:id="txtDni" promptText="Ej: 00000000A" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Fecha Nac.:" GridPane.rowIndex="1" GridPane.columnIndex="2" styleClass="etiqueta-campo"/>
            <DatePicker fx:id="dpFechaNacimiento" GridPane.rowIndex="1" GridPane.columnIndex="3" maxWidth="Infinity"/>

            <Label text="Teléfono:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="etiqueta-campo"/>
            <TextField fx:id="txtTelefono" promptText="Ej: 600 123 456" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Correo:" GridPane.rowIndex="2" GridPane.columnIndex="2" styleClass="etiqueta-campo"/>
            <TextField fx:id="txtCorreo" promptText="tuemail@ejemplo.com" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

            <Label text="Dirección:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="etiqueta-campo"/>
            <TextField fx:id="txtDireccion" promptText="C/ Ejemplo 123" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Nacionalidad:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="etiqueta-campo"/>
            <TextField fx:id="txtNacionalidad" promptText="Ej: Española" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Género:" GridPane.rowIndex="4" GridPane.columnIndex="2" styleClass="etiqueta-campo"/>
            <ComboBox fx:id="comboGenero" promptText="Seleccione..." GridPane.rowIndex="4" GridPane.columnIndex="3" maxWidth="Infinity">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Masculino"/>
                        <String fx:value="Femenino"/>
                        <String fx:value="No binario"/>
                        <String fx:value="Prefiero no especificar"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </GridPane>

        <Separator/>

        <VBox spacing="8">
            <Label text="Certificados" styleClass="titulo-seccion"/>
            <FlowPane hgap="15" vgap="10">
                <CheckBox fx:id="checkAuth1" text="Cert. Delitos Sexuales"/>
                <CheckBox fx:id="checkProtDatos" text="Cert. Protección Datos"/>
            </FlowPane>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox spacing="15.0" alignment="CENTER_RIGHT">
            <Button text="Cancelar" onAction="#cancelar" styleClass="boton-cancelar"/>
            <Button text="GUARDAR DOCENTE" onAction="#guardarDocente" styleClass="boton-accion"/>
        </HBox>

    </VBox>
</AnchorPane>
